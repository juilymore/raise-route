# =====================================================================
# .env.example — copy to .env.local (never commit .env.local)
# In Vercel: Project → Settings → Environment Variables (Production + Preview)
# NOTHING here is prefixed NEXT_PUBLIC_: the browser never needs a secret.
# =====================================================================

# ---------- Gemini (ALL AI tasks. Exam: Gemini Flash only. NO Claude API) ----------
GEMINI_API_KEY=
# Verify exact ids at https://ai.google.dev/gemini-api/docs/models (names change fast; /api/health checks them live)
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
# comma-separated fallbacks, tried in order on 404 (retired) or persistent 429. NOTE (verified 2026-10-12): gemini-2.5-flash now returns 404 for new users.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.7-flash
# true => use Gemini "Grounding with Google Search" for discovery (needs paid tier on Gemini 3.x; free tier only on 2.5 Flash)
GEMINI_ENABLE_GROUNDING=true
# hard budget guards (protects free-tier quota / your wallet)
LLM_MAX_CALLS_PER_RUN=200
LLM_MAX_CONCURRENCY=3

# ---------- Neon Postgres (server only) ----------
# Runtime: POOLED connection string (host contains "-pooler") for the role app_service (created by db/migrations/0000_neon_roles.sql).
DATABASE_URL=
# Migrations / db:test only: UNPOOLED connection string for the project owner role. Never used by the running app.
DATABASE_URL_UNPOOLED=

# ---------- App / security ----------
APP_BASE_URL=http://localhost:3000
# the passcode you give graders so they can click "Run now" / edit notes. Public visitors are read-only.
FOUNDER_ACCESS_CODE=
# random 32+ chars (openssl rand -hex 32)
SESSION_SECRET=
# Internal bearer secret for /api/pipeline/continue (the run re-invokes itself). No scheduler is used.
CRON_SECRET=
# serverless time budget per invocation; Hobby docs say 300s max (some reports say 60s => set 50000 if deploy rejects 300)
PIPELINE_TIME_BUDGET_MS=240000
MANUAL_RUN_COOLDOWN_MINUTES=30

# ---------- Email digest (Resend) ----------
RESEND_API_KEY=
# without a verified domain Resend only lets you send FROM onboarding@resend.dev TO the email you signed up with. That is fine for this project.
DIGEST_FROM=RaiseRoute <onboarding@resend.dev>
DIGEST_RECIPIENT=
# true => cron-triggered runs email the digest; manual runs never auto-send
DIGEST_AUTO_SEND=true

# ---------- Optional extra discovery (raw search results only; NEVER their LLM/answer features) ----------
TAVILY_API_KEY=
EXA_API_KEY=
