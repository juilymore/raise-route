{
  "name": "raiseroute",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && node scripts/check-compliance.mjs",
    "db:test": "node scripts/db-test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs --seed",
    "db:seed": "node scripts/db-migrate.mjs --seed-only",
    "db:app-role": "node scripts/db-setup-app-role.mjs",
    "smoke:sources": "tsx scripts/smoke-sources.ts",
    "evals": "tsx --conditions=react-server scripts/run-evals.ts",
    "pipeline:run": "tsx --conditions=react-server scripts/run-pipeline.ts",
    "inspect:run": "node scripts/inspect-run.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.9.11",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "p-limit": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "undici": "^8.11.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
